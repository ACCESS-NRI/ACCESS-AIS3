#!/bin/bash
# qsub -v PHASE=submit launch_ho_stressbalance_tests.pbs   (then PHASE=analyze once the solves finish)
#PBS -N ho_sbtests
#PBS -P au88
#PBS -q hugemem
#PBS -l walltime=06:00:00
#PBS -l ncpus=48
#PBS -l mem=1450GB
#PBS -l storage=gdata/au88+gdata/vk83+gdata/av17
#PBS -l wd
#PBS -o launch_ho_stressbalance_tests.pbs.out
#PBS -e launch_ho_stressbalance_tests.pbs.err
unset PYTHONPATH PYTHONSTARTUP PYTHONHOME
# Run in <repo>/config with the settings in site.env (submit from config/ or the repo root,
# or pass -v AIS3_ROOT=<repo>)
cd "${AIS3_ROOT:-$PBS_O_WORKDIR}"; [ -f site.env ] || cd config
[ -f site.env ] || { echo "config/site.env not found: qsub from <repo>/config" >&2; exit 1; }
set -a; . ./site.env; set +a
echo "PHASE=$PHASE"
"$AIS3_PYTHON" -u ho_stressbalance_tests.py
