#!/bin/bash
# Driver for melt_rescore_real_targets.py: re-scores the SSA melt candidates with the real ISMIP7
# J2 target and J4 (Python melt formula, no ISSM solves).
#PBS -N melt_rescore
#PBS -P au88
#PBS -q normal
#PBS -l walltime=02:00:00
#PBS -l ncpus=4
#PBS -l mem=48GB
#PBS -l storage=gdata/au88+gdata/vk83+gdata/av17
#PBS -l wd
#PBS -o launch_melt_rescore_real_targets.pbs.out
#PBS -e launch_melt_rescore_real_targets.pbs.err
unset PYTHONPATH PYTHONSTARTUP PYTHONHOME
cd "${AIS3_ROOT:-$PBS_O_WORKDIR}"; [ -f site.env ] || cd config
[ -f site.env ] || { echo "config/site.env not found: qsub from <repo>/config" >&2; exit 1; }
set -a; . ./site.env; set +a
"$AIS3_PYTHON" -u melt_rescore_real_targets.py
