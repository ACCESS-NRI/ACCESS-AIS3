#!/bin/bash
# Relaxed-start HO historical run with D2 rheology (worklog 5d). Writes NEW files:
# models/AIS3_historical_1995_2019_relaxfix.nc (checkpoint), ..._relaxfix_history_<t0>-<t1>.npz,
# execution/AIS3_historical_1995_2019_relaxfix. Submit once per chunk (4 chunks, 6 yr each);
# each submission resumes from the checkpoint. Rename this launcher's .out/.err (mv -n, add a
# chunk suffix) before submitting the next chunk so logs are kept.
#PBS -N hist_relaxfix
#PBS -P au88
#PBS -q hugemem
#PBS -l walltime=45:00:00
#PBS -l ncpus=48
#PBS -l mem=1450GB
#PBS -l storage=gdata/au88+gdata/vk83+gdata/av17
#PBS -l wd
#PBS -v AIS3_STEPS=historical_dhdt_tuning,AIS3_HIST_TAG=_relaxfix
#PBS -o /g/data/au88/jh7060/ACCESS-AIS3/config/launch_historical_relaxfix.pbs.out
#PBS -e /g/data/au88/jh7060/ACCESS-AIS3/config/launch_historical_relaxfix.pbs.err
unset PYTHONPATH PYTHONSTARTUP PYTHONHOME
cd /g/data/au88/jh7060/ACCESS-AIS3/config
echo "AIS3_STEPS=$AIS3_STEPS AIS3_HIST_TAG=$AIS3_HIST_TAG"
/scratch/au88/jh7060/mamba/envs/pyissm/bin/python -u ais_0.1.py
