#!/bin/bash
# qsub -v PHASE=submit launch_melt_gamma_sweep_ssa.pbs   (then PHASE=analyze once the 9 solves finish)
#PBS -N melt_gamma_sweep_ssa
#PBS -P au88
#PBS -q normal
#PBS -l walltime=03:00:00
#PBS -l ncpus=8
#PBS -l mem=190GB
#PBS -l storage=gdata/au88+gdata/vk83+gdata/av17
#PBS -l wd
#PBS -o launch_melt_gamma_sweep_ssa.pbs.out
#PBS -e launch_melt_gamma_sweep_ssa.pbs.err
unset PYTHONPATH PYTHONSTARTUP PYTHONHOME
# Run in <repo>/config with the settings in site.env (submit from config/ or the repo root,
# or pass -v AIS3_ROOT=<repo>)
cd "${AIS3_ROOT:-$PBS_O_WORKDIR}"; [ -f site.env ] || cd config
[ -f site.env ] || { echo "config/site.env not found: qsub from <repo>/config" >&2; exit 1; }
set -a; . ./site.env; set +a
echo "PHASE=$PHASE"
"$AIS3_PYTHON" -u melt_gamma_sweep_ssa.py
