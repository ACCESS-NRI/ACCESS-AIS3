#!/bin/bash
# Driver only (loads the model, builds forcing, waits on the 96-cpu solve): 24 cpu / 720 GB since
# annual output (2026-09-30); was 48 cpu / 1450 GB when every 0.1-yr 3D step was loaded (peak 500-700 GB).
#PBS -N historical_dhdt
#PBS -P au88
#PBS -q hugemem
#PBS -l walltime=45:00:00
#PBS -l ncpus=24
#PBS -l mem=720GB
#PBS -l storage=gdata/au88+gdata/vk83+gdata/av17
#PBS -l wd
#PBS -o launch_historical_dhdt_tuning.pbs.out
#PBS -e launch_historical_dhdt_tuning.pbs.err
unset PYTHONPATH PYTHONSTARTUP PYTHONHOME
# Run in <repo>/config with the settings in site.env (submit from config/ or the repo root,
# or pass -v AIS3_ROOT=<repo>)
cd "${AIS3_ROOT:-$PBS_O_WORKDIR}"; [ -f site.env ] || cd config
[ -f site.env ] || { echo "config/site.env not found: qsub from <repo>/config" >&2; exit 1; }
set -a; . ./site.env; set +a
"$AIS3_PYTHON" -u ais_0.1.py
