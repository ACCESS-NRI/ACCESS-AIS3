#!/bin/bash
# Driver for plot_calibration_figures.py: melt-calibration, SSA friction-law and pin-free HO figures
# (docs/figures), from the saved score files.
#PBS -N plot_calib
#PBS -P au88
#PBS -q normal
#PBS -l walltime=00:30:00
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l storage=gdata/au88+gdata/vk83+gdata/av17
#PBS -l wd
#PBS -o launch_plot_calibration_figures.pbs.out
#PBS -e launch_plot_calibration_figures.pbs.err
unset PYTHONPATH PYTHONSTARTUP PYTHONHOME
cd "${AIS3_ROOT:-$PBS_O_WORKDIR}"; [ -f site.env ] || cd config
[ -f site.env ] || { echo "config/site.env not found: qsub from <repo>/config" >&2; exit 1; }
set -a; . ./site.env; set +a
"$AIS3_PYTHON" -u plot_calibration_figures.py
