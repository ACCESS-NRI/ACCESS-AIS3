#!/bin/bash
# Driver for check_amundsen_soft_margins.py: Amundsen friction re-inversions with softened shear margins
# (B x 0.7, x 0.5; 48-cpu inner jobs), then shelf-removal stress balances on those and on J0.
#PBS -N amu_soft_marg
#PBS -P au88
#PBS -q normal
#PBS -l walltime=12:00:00
#PBS -l ncpus=4
#PBS -l mem=32GB
#PBS -l storage=gdata/au88+gdata/vk83+gdata/av17
#PBS -l wd
#PBS -o launch_check_amundsen_soft_margins.pbs.out
#PBS -e launch_check_amundsen_soft_margins.pbs.err
unset PYTHONPATH PYTHONSTARTUP PYTHONHOME
# Run in <repo>/config with the settings in site.env (submit from config/ or the repo root,
# or pass -v AIS3_ROOT=<repo>)
cd "${AIS3_ROOT:-$PBS_O_WORKDIR}"; [ -f site.env ] || cd config
[ -f site.env ] || { echo "config/site.env not found: qsub from <repo>/config" >&2; exit 1; }
set -a; . ./site.env; set +a
"$AIS3_PYTHON" -u check_amundsen_soft_margins.py
