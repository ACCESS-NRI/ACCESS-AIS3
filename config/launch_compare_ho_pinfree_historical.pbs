#!/bin/bash
# Driver for compare_ho_pinfree_historical.py: pin-free vs pinned HO historical runs against CPOM
# dH/dt, 1995-2019.
#PBS -N cmp_ho_pinfree
#PBS -P au88
#PBS -q normal
#PBS -l walltime=02:00:00
#PBS -l ncpus=4
#PBS -l mem=48GB
#PBS -l storage=gdata/au88+gdata/vk83+gdata/av17
#PBS -l wd
#PBS -o launch_compare_ho_pinfree_historical.pbs.out
#PBS -e launch_compare_ho_pinfree_historical.pbs.err
unset PYTHONPATH PYTHONSTARTUP PYTHONHOME
cd "${AIS3_ROOT:-$PBS_O_WORKDIR}"; [ -f site.env ] || cd config
[ -f site.env ] || { echo "config/site.env not found: qsub from <repo>/config" >&2; exit 1; }
set -a; . ./site.env; set +a
"$AIS3_PYTHON" -u compare_ho_pinfree_historical.py
