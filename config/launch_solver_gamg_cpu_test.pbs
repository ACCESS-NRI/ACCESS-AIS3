#!/bin/bash
# qsub -v PHASE=submit launch_solver_gamg_cpu_test.pbs   (then PHASE=analyze once the solves finish)
#PBS -N solver_gamg
#PBS -P au88
#PBS -q normal
#PBS -l walltime=01:00:00
#PBS -l ncpus=4
#PBS -l mem=32GB
#PBS -l storage=gdata/au88+gdata/vk83+gdata/av17
#PBS -l wd
#PBS -o launch_solver_gamg_cpu_test.pbs.out
#PBS -e launch_solver_gamg_cpu_test.pbs.err
unset PYTHONPATH PYTHONSTARTUP PYTHONHOME
# Run in <repo>/config with the settings in site.env (submit from config/ or the repo root,
# or pass -v AIS3_ROOT=<repo>)
cd "${AIS3_ROOT:-$PBS_O_WORKDIR}"; [ -f site.env ] || cd config
[ -f site.env ] || { echo "config/site.env not found: qsub from <repo>/config" >&2; exit 1; }
set -a; . ./site.env; set +a
echo "PHASE=$PHASE CASES=$CASES"
"$AIS3_PYTHON" -u solver_gamg_cpu_test.py
