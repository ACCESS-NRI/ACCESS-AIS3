# ACCESS-AIS3 site settings: the one file to edit when you run AIS3 under another NCI
# account, project or Python environment.
#
# Each line is KEY=${KEY:-default}, so an environment variable of the same name overrides it,
# e.g. `qsub -v AIS3_PROJECT=xy12 ...` or `export AIS3_PYTHON=...` before a notebook session.
# Read by every launcher (sourced by bash) and by ais3_site.py (parsed, same rules).
#
# Not set here because they are found automatically:
#   repository root  the folder above this config/ folder (override with AIS3_ROOT)
#   NCI username     $USER (override with AIS3_USER)

# NCI project that is charged for the jobs, and the storage the jobs mount
AIS3_PROJECT=${AIS3_PROJECT:-au88}
AIS3_STORAGE=${AIS3_STORAGE:-gdata/au88+gdata/vk83+gdata/av17}

# Python with pyissm, ccdtools and (for notebooks) jupyter plus a kernel named 'pyissm'
AIS3_PYTHON=${AIS3_PYTHON:-/scratch/au88/jh7060/mamba/envs/pyissm/bin/python}

# ISSM build (ACCESS-NRI, project vk83); must match the module the inner jobs load
AIS3_ISSM_DIR=${AIS3_ISSM_DIR:-/g/data/vk83/apps/spack/1.1/release/linux-x86_64/issm-git.2026.05.18_2026.05.18-kgta35igm37z4qnqnul7rcmgx2inftqd}

# ISMIP forcing tree (ISMIP6/ISMIP7 2300 forcings, observations MIPkit, ocean climatology)
AIS3_ISMIP_DIR=${AIS3_ISMIP_DIR:-/g/data/au88/ismip6/2300/forcings}

# GPU ISSM build (ACCESS-NRI/ISSM fork, branch justinh2002/GPU_cuda, PETSc + CUDA + hypre in
# externalpackages/petsc/install-gpu-hypre); only the solver_*gpu* tests use it
AIS3_GPU_ISSM_DIR=${AIS3_GPU_ISSM_DIR:-/g/data/au88/jh7060/ISSM}
