#!/bin/bash
# Driver for check_ho_unpin_1995.py: releases all pins on the 1995 relaxed HO state (Schoof, and the
# SSA Budd field), submits two 96-cpu hugemem stress-balance solves, polls them, compares speeds.
#PBS -N ho_unpin1995
#PBS -P au88
#PBS -q hugemem
#PBS -l walltime=40:00:00
#PBS -l ncpus=24
#PBS -l mem=720GB
#PBS -l storage=gdata/au88+gdata/vk83+gdata/av17
#PBS -l wd
#PBS -o launch_check_ho_unpin_1995.pbs.out
#PBS -e launch_check_ho_unpin_1995.pbs.err
unset PYTHONPATH PYTHONSTARTUP PYTHONHOME
# Run in <repo>/config with the settings in site.env (submit from config/ or the repo root,
# or pass -v AIS3_ROOT=<repo>)
cd "${AIS3_ROOT:-$PBS_O_WORKDIR}"; [ -f site.env ] || cd config
[ -f site.env ] || { echo "config/site.env not found: qsub from <repo>/config" >&2; exit 1; }
set -a; . ./site.env; set +a
"$AIS3_PYTHON" -u check_ho_unpin_1995.py
