#!/bin/bash
# Driver for melt_calibration_hm_refit_ho.py: per-basin deltaT at gamma_0 = 1000, 4000, 8000 for the
# history-matched melt calibration (Python melt formula, no ISSM solves).
#PBS -N melt_hm_refit_ho
#PBS -P au88
#PBS -q normal
#PBS -l walltime=02:00:00
#PBS -l ncpus=4
#PBS -l mem=48GB
#PBS -l storage=gdata/au88+gdata/vk83+gdata/av17
#PBS -l wd
#PBS -o launch_melt_calibration_hm_refit_ho.pbs.out
#PBS -e launch_melt_calibration_hm_refit_ho.pbs.err
unset PYTHONPATH PYTHONSTARTUP PYTHONHOME
cd "${AIS3_ROOT:-$PBS_O_WORKDIR}"; [ -f site.env ] || cd config
[ -f site.env ] || { echo "config/site.env not found: qsub from <repo>/config" >&2; exit 1; }
set -a; . ./site.env; set +a
"$AIS3_PYTHON" -u melt_calibration_hm_refit_ho.py
